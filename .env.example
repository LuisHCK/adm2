# Copy to `.env` for local overrides. Values here are defaults, not secrets.
# `.env` is gitignored; never commit real credentials.

# Frontend (Vite) — the app falls back to `es` when these are unset.
VITE_I18N_LOCALE=es
VITE_I18N_FALLBACK_LOCALE=es

# Server (v2) — not implemented yet; documented here for the eventual config.
# ADM2_PORT=8080
# ADM2_DATA_DIR=./data
# ADM2_JWT_SECRET=
